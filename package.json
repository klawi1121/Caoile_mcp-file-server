{
  "name": "caoile-mcp-file-server",
  "version": "1.0.0",
  "description": "Secure Sandboxed MCP File-Server Connector with Multi-Agent Handoff Protocol",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
